#!/bin/sh
# Riley Settings, the control panel (Super+Ctrl+S): starts the Qt panel, riley-settings-qt, or the GTK panel that
# was here before (riley-settings-gtk, next to this file).
#
#   riley-settings [--gtk] [ARGS...]
#
# The panel: the GTK one for this run with --gtk; else the first word of ~/.config/riley/settings-panel when it is
# "gtk" (riley-settings-use gtk|qt writes it); else the Qt one. The Qt panel runs with --apply-actions; when it is
# not installed, or cannot start (exit 127), the GTK panel runs instead.

here=$(dirname "$(readlink -f "$0")")
gtk=$here/riley-settings-gtk

panel=
for arg do
    shift
    case $arg in
        --gtk) panel=gtk ;;
        *) set -- "$@" "$arg" ;;
    esac
done

if [ -z "$panel" ]; then
    word=
    choice=${XDG_CONFIG_HOME:-$HOME/.config}/riley/settings-panel
    if [ -r "$choice" ]; then
        read -r word _ <"$choice" || :
    fi
    if [ "$word" = gtk ]; then panel=gtk; else panel=qt; fi
fi

if [ "$panel" = qt ] && command -v riley-settings-qt >/dev/null 2>&1; then
    riley-settings-qt --apply-actions "$@"
    code=$?
    [ "$code" -eq 127 ] || exit "$code"
fi
exec "$gtk" "$@"
