#!/bin/sh
# Chooses the panel riley-settings (Super+Ctrl+S) starts, for good:
#
#   riley-settings-use gtk    the GTK panel
#   riley-settings-use qt     the Qt panel (riley-settings-qt), the default
#
# Writes the word into ~/.config/riley/settings-panel (by a temporary file and a rename) and starts nothing.

usage() {
    echo "usage: riley-settings-use gtk|qt" >&2
    exit 2
}

[ "$#" -eq 1 ] || usage
case $1 in
    gtk|qt) ;;
    *) usage ;;
esac

dir=${XDG_CONFIG_HOME:-$HOME/.config}/riley
mkdir -p "$dir" || exit 1
tmp=$(mktemp "$dir/.settings-panel.XXXXXX") || exit 1
if printf '%s\n' "$1" >"$tmp" && mv -f "$tmp" "$dir/settings-panel"; then
    exit 0
fi
rm -f "$tmp"
exit 1
